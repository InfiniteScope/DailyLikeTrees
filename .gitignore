# ============================================================
# DailyLikeTrees — .gitignore
# ============================================================

# ── Dependencies ──
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ── Build output ──
frontend/dist/
frontend/dist-ssr/
*.local
backend/build/
backend/dist/
backend/*.spec
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/
frontend/android/*.keystore
frontend/android/keystore.properties

# ── Database & data (may contain user data) ──
*.db
*.sqlite3
*.sqlite

# ── Environment & secrets ──
.env
.env.*
!.env.example
!.env.pwa

# ── IDE & editors ──
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# ── OS generated ──
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Electron ──
electron-app/node_modules/
electron-app/release/
electron-app/dist/

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Docs ──
# docs/ 目录保存全部开发文档，仅 CLAUDE.md 与 PROJECT.md 上传仓库
docs/*
!docs/CLAUDE.md
!docs/PROJECT.md

# ── Claude Code local ──
.claude/

# ── Scratch / personal notes ──
TODO*.md
*.tmp

# ── Portable distribution zip ──
DailyLikeTrees-portable.zip
dist-portable/

# ── Screenshots ──
screenshots/

# ── Test coverage ──
coverage/
.nyc_output/
htmlcov/
.pytest_cache/

# ── Misc ──
*.bak
*.orig
